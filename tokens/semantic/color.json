{
  "color": {
    "$description": "Layer 2 semantics, the only color tokens component code may name. Every value references Layer 1 and every name says the job it does. These are the DARK values, the default on :root; tokens/themes/light.json overrides the same set. Each role sits on the same iTerm slot in both themes.",
    "surface": {
      "sunken": {
        "$type": "color",
        "$value": "{palette.derived.dark-sunken}"
      },
      "base": {
        "$type": "color",
        "$value": "{palette.dark.background}"
      },
      "raised": {
        "$type": "color",
        "$value": "{palette.dark.cursor-guide}"
      },
      "overlay": {
        "$type": "color",
        "$value": "{palette.derived.dark-overlay}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{palette.dark.foreground}"
      },
      "muted": {
        "$type": "color",
        "$value": "{palette.dark.black}"
      },
      "on-primary": {
        "$type": "color",
        "$value": "{palette.dark.cursor-text}"
      }
    },
    "primary": {
      "solid": {
        "$type": "color",
        "$value": "{palette.dark.cursor}"
      },
      "hover": {
        "$type": "color",
        "$value": "{palette.dark.bright-yellow}"
      },
      "text": {
        "$type": "color",
        "$value": "{palette.dark.cursor}"
      }
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "{palette.dark.cyan}"
      }
    },
    "link": {
      "$type": "color",
      "$value": "{palette.dark.link}"
    },
    "selection": {
      "background": {
        "$type": "color",
        "$value": "{palette.dark.selection}"
      },
      "text": {
        "$type": "color",
        "$value": "{palette.dark.selected-text}"
      }
    },
    "ansi": {
      "red": {
        "$type": "color",
        "$value": "{palette.dark.red}"
      },
      "bright-red": {
        "$type": "color",
        "$value": "{palette.dark.bright-red}"
      },
      "green": {
        "$type": "color",
        "$value": "{palette.dark.green}"
      },
      "bright-green": {
        "$type": "color",
        "$value": "{palette.dark.bright-green}"
      },
      "yellow": {
        "$type": "color",
        "$value": "{palette.dark.yellow}"
      },
      "bright-yellow": {
        "$type": "color",
        "$value": "{palette.dark.bright-yellow}"
      },
      "blue": {
        "$type": "color",
        "$value": "{palette.dark.blue}"
      },
      "bright-blue": {
        "$type": "color",
        "$value": "{palette.dark.bright-blue}"
      },
      "magenta": {
        "$type": "color",
        "$value": "{palette.dark.magenta}"
      },
      "bright-magenta": {
        "$type": "color",
        "$value": "{palette.dark.bright-magenta}"
      },
      "cyan": {
        "$type": "color",
        "$value": "{palette.dark.cyan}"
      },
      "bright-cyan": {
        "$type": "color",
        "$value": "{palette.dark.bright-cyan}"
      }
    },
    "track": {
      "1": {
        "$type": "color",
        "$value": "{palette.dark.blue}"
      },
      "2": {
        "$type": "color",
        "$value": "{palette.dark.magenta}"
      },
      "3": {
        "$type": "color",
        "$value": "{palette.dark.red}"
      },
      "4": {
        "$type": "color",
        "$value": "{palette.dark.cyan}"
      },
      "5": {
        "$type": "color",
        "$value": "{palette.dark.green}"
      },
      "6": {
        "$type": "color",
        "$value": "{palette.dark.yellow}"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "{palette.dark.red}"
    },
    "success": {
      "$type": "color",
      "$value": "{palette.dark.green}"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{palette.dark.cursor}"
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{palette.alpha.light.6}"
      },
      "strong": {
        "$type": "color",
        "$value": "{palette.alpha.light.12}"
      }
    }
