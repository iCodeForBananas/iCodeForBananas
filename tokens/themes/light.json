{
  "light": {
    "$description": "Light theme: Layer 2 overrides only, emitted under [data-theme=\"light\"]. Every role is the same iTerm slot as dark, read from the light scheme.",
    "color": {
      "surface": {
        "sunken": {
          "$type": "color",
          "$value": "{palette.derived.light-sunken}"
        },
        "base": {
          "$type": "color",
          "$value": "{palette.light.background}"
        },
        "raised": {
          "$type": "color",
          "$value": "{palette.light.cursor-guide}"
        },
        "overlay": {
          "$type": "color",
          "$value": "{palette.light.background}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{palette.light.foreground}"
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.light.white}"
        },
        "on-primary": {
          "$type": "color",
          "$value": "{palette.light.cursor-text}"
        }
      },
      "primary": {
        "solid": {
          "$type": "color",
          "$value": "{palette.light.cursor}"
        },
        "hover": {
          "$type": "color",
          "$value": "{palette.light.yellow}"
        },
        "text": {
          "$type": "color",
          "$value": "{palette.light.cursor}"
        }
      },
      "accent": {
        "solid": {
          "$type": "color",
          "$value": "{palette.light.cyan}"
        }
      },
      "link": {
        "$type": "color",
        "$value": "{palette.light.link}"
      },
      "selection": {
        "background": {
          "$type": "color",
          "$value": "{palette.light.selection}"
        },
        "text": {
          "$type": "color",
          "$value": "{palette.light.selected-text}"
        }
      },
      "ansi": {
        "red": {
          "$type": "color",
          "$value": "{palette.light.red}"
        },
        "bright-red": {
          "$type": "color",
          "$value": "{palette.light.bright-red}"
        },
        "green": {
          "$type": "color",
          "$value": "{palette.light.green}"
        },
        "bright-green": {
          "$type": "color",
          "$value": "{palette.light.bright-green}"
        },
        "yellow": {
          "$type": "color",
          "$value": "{palette.light.yellow}"
        },
        "bright-yellow": {
          "$type": "color",
          "$value": "{palette.light.bright-yellow}"
        },
        "blue": {
          "$type": "color",
          "$value": "{palette.light.blue}"
        },
        "bright-blue": {
          "$type": "color",
          "$value": "{palette.light.bright-blue}"
        },
        "magenta": {
          "$type": "color",
          "$value": "{palette.light.magenta}"
        },
        "bright-magenta": {
          "$type": "color",
          "$value": "{palette.light.bright-magenta}"
        },
        "cyan": {
          "$type": "color",
          "$value": "{palette.light.cyan}"
        },
        "bright-cyan": {
          "$type": "color",
          "$value": "{palette.light.bright-cyan}"
        }
      },
      "track": {
        "1": {
          "$type": "color",
          "$value": "{palette.light.blue}"
        },
        "2": {
          "$type": "color",
          "$value": "{palette.light.magenta}"
        },
        "3": {
          "$type": "color",
          "$value": "{palette.light.red}"
        },
        "4": {
          "$type": "color",
          "$value": "{palette.light.cyan}"
        },
        "5": {
          "$type": "color",
          "$value": "{palette.light.green}"
        },
        "6": {
          "$type": "color",
          "$value": "{palette.light.yellow}"
        }
      },
      "danger": {
        "$type": "color",
        "$value": "{palette.light.red}"
      },
      "success": {
        "$type": "color",
        "$value": "{palette.light.green}"
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{palette.light.cursor}"
      },
      "border": {
        "subtle": {
          "$type": "color",
          "$value": "{palette.alpha.dark.8}"
        },
        "strong": {
          "$type": "color",
          "$value": "{palette.alpha.dark.14}"
        }
      }
    }
  }
}
