{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@/*": ["../*"] }
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "runtime/**/*.ts", "scripts/**/*.ts", "deployments.ts"],
  "exclude": ["node_modules", "cdk.out"]
}
